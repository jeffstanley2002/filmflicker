# Copy this file to .streamlit/secrets.toml for local dev (gitignored),
# or paste its contents into the "Secrets" box in Streamlit Community Cloud
# settings when deploying. Both are optional - the app degrades gracefully
# without either one.

# Movie posters. Get a free key instantly at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY = "your_key_here"

# Persistent Postgres (e.g. a free Supabase project) instead of local SQLite,
# so real users' profiles/watched/ratings survive redeploys. See README's
# "Setting up Postgres (Supabase)" section. Leave commented out to keep
# using local SQLite (fine for personal/demo use).
# DATABASE_URL = "postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
