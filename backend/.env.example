# Copy to backend/.env for local dev (gitignored). Use the same values in
# your production API host.

# Supabase Postgres connection string.
DATABASE_URL=postgresql://postgres.xxxxx:yourpassword@aws-1-xx-xxxx-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase project URL, without /rest/v1.
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase project settings -> API -> JWT Settings -> JWT Secret.
# Used only for legacy HS256 tokens. Newer asymmetric tokens use SUPABASE_URL + JWKS.
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
